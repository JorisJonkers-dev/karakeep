DATA_DIR=/data
# Kubernetes sets HOSTNAME to the pod name, which Next.js would bind to alone.
HOSTNAME=0.0.0.0
NEXTAUTH_URL=${exposure:karakeep.public#url}
NEXTAUTH_SECRET=${secret:secret/data/platform/karakeep#nextauth_secret}

# karakeep-start builds MEILI_ADDR and BROWSER_WEB_URL from these.
KARAKEEP_SEARCH_HOST=${dependency:karakeep-search.host}
KARAKEEP_SEARCH_PORT=${dependency:karakeep-search.port}
MEILI_MASTER_KEY=${secret:secret/data/platform/karakeep#meili_master_key}
KARAKEEP_CHROME_HOST=${dependency:karakeep-chrome.host}
KARAKEEP_CHROME_PORT=${dependency:karakeep-chrome.port}

KARAKEEP_S3_ENDPOINT=http://garage.data-system.svc.cluster.local:3900
KARAKEEP_S3_REGION=garage
KARAKEEP_S3_KEY_HEX=${secret:secret/data/karakeep-system/garage#s3.key_hex}
KARAKEEP_S3_SECRET_ACCESS_KEY=${secret:secret/data/karakeep-system/garage#s3.secret}
KARAKEEP_LITESTREAM_BUCKET=karakeep-litestream
ASSET_STORE_S3_BUCKET=karakeep-assets

OPENAI_API_KEY=${secret:secret/data/platform/karakeep#mistral_api_key}
OPENAI_API_BASE=https://api.mistral.ai/v1
INFERENCE_TEXT_MODEL=mistral-small-2603
INFERENCE_IMAGE_MODEL=mistral-small-2603
INFERENCE_CONTEXT_LENGTH=2048
INFERENCE_ENABLE_AUTO_TAGGING=true
INFERENCE_ENABLE_AUTO_SUMMARIZATION=true
